{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "UatConnection": "",
    "LiveConnection": ""
  },
  "JwtSettings": {
    "Issuer": "SmartFuture.API",
    "Audience": "SmartFuture.Clients",
    "Key": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Diagnostics": {
    "ExposeExceptionDetails": false
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "Webhooks": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "General": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    }
  },
  "ForwardedHeaders": {
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Maintenance": {
    "ExpiredRefreshTokenCleanup": {
      "Enabled": true,
      "IntervalMinutes": 360
    }
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  }
}
